# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- SUPABASE CONFIGURATION (POSTGRES DATABASE & STORAGE) ---
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- RAZORPAY PAYMENT GATEWAY (UPI, CARDS, NETBANKING) ---
# Obtain from https://dashboard.razorpay.com/app/keys (Use Test Key in Development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# --- EMAIL NOTIFICATIONS (RESEND) ---
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL=Riwayat Atelier <orders@riwayat-gifting.com>
OWNER_EMAIL=hello@riwayat.example

# --- WHATSAPP NOTIFICATIONS (META CLOUD API OR TWILIO) ---
# Feature flag: set to true once WhatsApp Cloud API keys are connected
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=100654321098765
WHATSAPP_ACCESS_TOKEN=EAAG...
OWNER_WHATSAPP=+919876543210
